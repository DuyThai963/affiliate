# ==========================================
# ACCESSTRADE CONFIGURATION (Bắt buộc)
# ==========================================
# Lấy API Key tại: https://workspace.accesstrade.vn/ -> Profile / API Key
ACCESSTRADE_API_KEY=your_accesstrade_api_key_here

# ID Chiến dịch Shopee CPS trên Accesstrade (Thường là 4751584435713464237 hoặc shopee)
SHOPEE_CAMPAIGN_ID=4751584435713464237

# ID Chiến dịch TikTok Shop CPS trên Accesstrade (Mặc định: 749)
TIKTOK_CAMPAIGN_ID=749

# ID Chiến dịch F&B
HIGHLANDS_CAMPAIGN_ID=774
TCH_CAMPAIGN_ID=756

# ==========================================
# FACEBOOK GRAPH API CONFIGURATION (Tùy chọn)
# Dùng cho phễu mở khóa mã Shopee qua comment Facebook
# ==========================================
# ID Fanpage cá nhân
FB_PAGE_ID=

# ID Bài viết ghim săn sale trên Fanpage
FB_POST_ID=

# Page Access Token (Có quyền pages_manage_posts, pages_read_engagement)
FB_PAGE_ACCESS_TOKEN=
